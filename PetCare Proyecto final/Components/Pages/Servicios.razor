@page "/citas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PetCare_Proyecto_final.Data.PetCareDataService Data

<PageTitle>Citas médicas | PetCare</PageTitle>

<div class="saas-page-heading"><div><span class="page-eyebrow">Operaciones</span><h1>Citas médicas</h1><p>Registra y consulta citas médicas de 15 a 180 minutos.</p></div></div>

@if (!string.IsNullOrEmpty(Message) && !IsCreateOpen)
{
    <div class="@(IsError ? "operation-error" : "operation-success")" role="alert">@Message</div>
}

@if (CanOperate)
{
    <button class="saas-primary-button modal-trigger" type="button" @onclick="OpenCreate"><i data-lucide="stethoscope" aria-hidden="true"></i> Nueva cita</button>
    @if (IsCreateOpen)
    {
        <div class="modal-backdrop" role="presentation" @onclick="CloseCreate"><div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="new-service-title" @onclick:stopPropagation="true"><div class="modal-header"><div><span class="page-eyebrow">Nueva cita</span><h2 id="new-service-title">Registrar cita médica</h2></div><button class="modal-close" type="button" aria-label="Cerrar" @onclick="CloseCreate">×</button></div>@if (!string.IsNullOrEmpty(Message)){<div class="@(IsError ? "operation-error" : "operation-success")" role="alert">@Message</div>}<ServiceForm Veterinarians="Veterinarians" Clients="Clients" OnSubmit="RegisterServiceAsync" /></div></div>
    }
}

@if (Rows is null)
{
    <div class="loading-state">Cargando citas...</div>
}
else
{
    <div class="data-card"><div class="data-card-header"><strong>Citas registradas</strong><span>@Rows.Count registros</span></div><div class="table-scroll"><table class="saas-table"><thead><tr><th>Código</th><th>Mascota</th><th>Fecha</th><th>Veterinario</th><th>Detalle</th>@if (CanOperate){<th>Acción</th>}</tr></thead><tbody>@foreach (var row in Rows){<tr><td class="table-primary">@row.Code</td><td>@row.PetName</td><td>@row.Date.ToString("dd/MM/yyyy HH:mm")</td><td>@if (CanOperate){<select class="role-select" aria-label="Veterinario para @row.Code" value="@serviceVets.GetValueOrDefault(row.Id)" @onchange="e => serviceVets[row.Id] = int.TryParse(e.Value?.ToString(), out var value) ? value : 0"><option value="0">Sin asignar</option>@foreach (var vet in Veterinarians){<option value="@vet.Id">@vet.Name</option>}</select>}else{<span>@(row.Veterinarian ?? "Sin asignar")</span>}</td><td>@row.DurationMinutes min</td>@if (CanOperate){<td><button class="text-action" @onclick="() => SaveVeterinarianAsync(row.Id)">Confirmar veterinario</button></td>}</tr>}</tbody></table></div></div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.ServiceRow>? Rows;
    private IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.VetOption> Veterinarians = [];
    private IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.ClientOption> Clients = [];
    private Dictionary<int, int> serviceVets = [];
    private string? Message;
    private bool IsError;
    private bool IsCreateOpen;
    private string ActorRole => AuthenticationState?.Result.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
    private bool IsAdmin => ActorRole == "Director";
    private bool CanOperate => ActorRole is "Director" or "Recepcionista" or "Veterinario";
    private int ActorId => int.TryParse(AuthenticationState?.Result.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync(){ Rows = (await Data.GetServicesAsync(ActorRole, ActorId)).Where(x => x.Type == "Cita").ToList(); Veterinarians = await Data.GetVeterinariansAsync(); Clients = await Data.GetClientsAsync(); serviceVets = Rows.ToDictionary(x => x.Id, x => x.VeterinarianId ?? 0); }
    private async Task RegisterServiceAsync(ServiceForm.ServiceFormModel model){ try { await Data.CreateAppointmentAsync(ActorRole, new(model.Code, model.PetName, model.Date, model.DurationMinutes, model.VeterinarianId, model.ClientId)); Message = "La cita se registró correctamente."; IsError = false; IsCreateOpen = false; await ReloadAsync(); } catch (DomainOperationException ex) { Message = ex.Message; IsError = true; } }
    private void OpenCreate(){Message=null;IsCreateOpen=true;}
    private void CloseCreate(){IsCreateOpen=false;}
    private async Task SaveVeterinarianAsync(int serviceId){try{await Data.UpdateServiceVeterinarianAsync(ActorRole,serviceId,serviceVets.GetValueOrDefault(serviceId));Message="Veterinario actualizado correctamente.";IsError=false;await ReloadAsync();}catch(DomainOperationException ex){Message=ex.Message;IsError=true;}}
}
