(() => {
    const renderIcons = () => {
        if (window.lucide) {
            window.lucide.createIcons();
        }
    };

    const observer = new MutationObserver(() => {
        window.requestAnimationFrame(renderIcons);
    });

    observer.observe(document.body, { childList: true, subtree: true });
    renderIcons();
})();
