@page "/dashboard"
@attribute [Authorize]
@inject PetCare_Proyecto_final.Data.PetCareDataService Data

<PageTitle>Dashboard | PetCare</PageTitle>

<div class="saas-page-heading">
	<div><span class="page-eyebrow">Resumen general</span><h1>Dashboard</h1><p>Una vista rápida de la actividad de PetCare.</p></div>
	<span class="date-badge"><i data-lucide="calendar-days" aria-hidden="true"></i> @DateTime.Now.ToString("dd MMM yyyy")</span>
</div>

@if (Summary is null)
{
	<div class="loading-state">Cargando resumen...</div>
}
else
{
	<div class="metric-grid">
		<div class="metric-card"><span class="metric-icon"><i data-lucide="users" aria-hidden="true"></i></span><small>Usuarios</small><strong>@Summary.Users</strong><span class="metric-detail">Usuarios registrados</span></div>
		<div class="metric-card"><span class="metric-icon"><i data-lucide="stethoscope" aria-hidden="true"></i></span><small>Servicios</small><strong>@Summary.Services</strong><span class="metric-detail">@Summary.Appointments citas · @Summary.Hospitalizations hospitalizaciones</span></div>
		<div class="metric-card"><span class="metric-icon"><i data-lucide="package" aria-hidden="true"></i></span><small>Productos</small><strong>@Summary.Products</strong><span class="metric-detail">Productos en catálogo</span></div>
		<div class="metric-card"><span class="metric-icon"><i data-lucide="receipt-text" aria-hidden="true"></i></span><small>Facturas</small><strong>@Summary.Invoices</strong><span class="metric-detail">Facturas emitidas</span></div>
	</div>

	<section class="dashboard-welcome">
		<div><span class="page-eyebrow">PetCare en un vistazo</span><h2>Gestiona cada detalle desde un solo lugar.</h2><p>Utiliza el menú lateral para consultar usuarios, servicios, productos y facturación.</p></div>
		<i data-lucide="sparkles" aria-hidden="true"></i>
	</section>
}

@code {
	private PetCare_Proyecto_final.Data.PetCareDataService.DashboardSummary? Summary;

	protected override async Task OnInitializedAsync()
	{
		Summary = await Data.GetDashboardSummaryAsync();
	}
}
