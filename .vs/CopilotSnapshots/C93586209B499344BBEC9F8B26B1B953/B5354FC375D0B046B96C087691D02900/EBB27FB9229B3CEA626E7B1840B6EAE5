@page "/usuarios"
@attribute [Authorize]
@inject PetCare_Proyecto_final.Data.PetCareDataService Data

<PageTitle>Usuarios | PetCare</PageTitle>

<div class="saas-page-heading"><div><span class="page-eyebrow">Administración</span><h1>Usuarios</h1><p>Gestiona las personas con acceso al sistema.</p></div><button class="saas-primary-button" type="button"><i data-lucide="user-plus" aria-hidden="true"></i> Nuevo usuario</button></div>

@if (Rows is null)
{
	<div class="loading-state">Cargando usuarios...</div>
}
else
{
	<div class="data-card"><div class="data-card-header"><strong>Usuarios registrados</strong><span>@Rows.Count registros</span></div><div class="table-scroll"><table class="saas-table"><thead><tr><th>Usuario</th><th>Nombre completo</th><th>Rol</th><th>Estado</th></tr></thead><tbody>@foreach (var row in Rows)<tr><td class="table-primary">@row.Username</td><td>@row.FullName</td><td><span class="role-badge">@row.Role</span></td><td><span class="status-badge">Activo</span></td></tr></tbody></table></div></div>
}

@code {
	private IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.UserRow>? Rows;

	protected override async Task OnInitializedAsync() => Rows = await Data.GetUsersAsync();
}
