.page {
    position: relative;
    display: flex;
    flex-direction: column;
}

main {
    flex: 1;
}

.saas-shell {
    min-height: 100vh;
    display: flex;
    background: #f7f8fa;
}

.sidebar {
    width: 250px;
    min-height: 100vh;
    flex: 0 0 250px;
    background: #0d1933;
    color: #ffffff;
}

.saas-main {
    min-width: 0;
    flex: 1;
}

.top-row {
    min-height: 76px;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e0e0e0;
    background: #ffffff;
}

.top-row-label,
.current-user small {
    display: block;
    color: #667085;
    font-size: .75rem;
}

.top-row strong {
    color: #0d1933;
}

.current-user {
    display: flex;
    align-items: center;
    gap: .65rem;
}

.current-user strong {
    display: block;
    font-size: .86rem;
}

.user-avatar {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    background: #fef3c7;
    color: #d97706;
}

.user-avatar svg {
    width: 1.1rem;
}

.content {
    max-width: 1440px;
    margin: 0 auto;
    padding: 2rem;
}

#blazor-error-ui {
    color: #0d1933;
    background: #fef3c7;
    bottom: 0;
    box-shadow: 0 -1px 2px rgba(13, 25, 51, .2);
    box-sizing: border-box;
    display: none;
    left: 0;
    padding: .8rem 1.25rem;
    position: fixed;
    width: 100%;
    z-index: 1000;
}

#blazor-error-ui .reload {
    margin-left: 1rem;
    color: #d97706;
}

#blazor-error-ui .dismiss {
    cursor: pointer;
    position: absolute;
    right: .75rem;
}

@media (max-width: 760px) {
    .saas-shell {
        display: block;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
    }

    .content {
        padding: 1.25rem;
    }
}
