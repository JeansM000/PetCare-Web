@page "/login"
@layout PublicLayout

<PageTitle>Iniciar sesión | PetCare</PageTitle>

<section class="public-info-page login-page">
	<span class="eyebrow">Bienvenido de nuevo</span>
	<h1>Inicia sesión en PetCare.</h1>
	@if (Error is not null)
	{
		<p class="login-error" role="alert">El usuario o la contraseña no son correctos.</p>
	}
	<form class="login-form" method="post" action="/account/login">
		<AntiforgeryToken />
		<label for="email">Correo electrónico</label>
		<input id="email" name="username" type="text" maxlength="50" autocomplete="username" placeholder="admin" required />
		<label for="password">Contraseña</label>
		<input id="password" name="password" type="password" maxlength="200" autocomplete="current-password" placeholder="Tu contraseña" required />
		<button type="submit" class="primary-action">Iniciar sesión</button>
	</form>
</section>

@code {
	[SupplyParameterFromQuery(Name = "error")]
	private string? Error { get; set; }
}
