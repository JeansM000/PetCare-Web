html, body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: #FFFFFF;
    color: #0D1933;
}

a, .btn-link {
    color: #D97706;
}

.btn-primary {
    color: #FFFFFF;
    background-color: #D97706;
    border-color: #D97706;
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

.content {
    padding-top: 1.1rem;
}

h1:focus {
    outline: none;
}

.valid.modified:not([type=checkbox]) {
    outline: 1px solid #26b050;
}

.invalid {
    outline: 1px solid #e50000;
}

.validation-message {
    color: #e50000;
}

.blazor-error-boundary {
    background: url(data:image/svg+xml;base64,) no-repeat 1rem/1.8rem, #b32121;
    padding: 1rem 1rem 1rem 3.7rem;
    color: white;
}

    .blazor-error-boundary::after {
        content: "An error has occurred."
    }

.darker-border-checkbox.form-check-input {
    border-color: #929292;
}

.form-floating > .form-control-plaintext::placeholder, .form-floating > .form-control::placeholder {
    color: var(--bs-secondary-color);
    text-align: end;
}

.form-floating > .form-control-plaintext:focus::placeholder, .form-floating > .form-control:focus::placeholder {
    text-align: start;
}

.public-info-page {
    width: min(900px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 6rem 0 4rem;
}

.public-info-page h1 {
    max-width: 760px;
    margin: 1rem 0;
    color: #0D1933;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -.05em;
}

.public-info-page .eyebrow {
    color: #D97706;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.lead {
    max-width: 650px;
    color: #667085;
    font-size: 1.1rem;
    line-height: 1.7;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 3.5rem;
}

.info-grid article,
.pricing-card,
.about-note {
    padding: 1.5rem;
    border: 1px solid #E0E0E0;
    border-radius: .75rem;
}

.info-grid article > span,
.pricing-label {
    color: #D97706;
    font-size: .78rem;
    font-weight: 800;
}

.info-grid h2,
.about-note strong,
.terms-content h2 {
    color: #0D1933;
}

.info-grid p,
.about-note p,
.terms-content p {
    color: #667085;
    line-height: 1.6;
}

.pricing-card {
    max-width: 560px;
    margin-top: 3rem;
    display: grid;
    gap: 1.5rem;
    background: #F8F8F8;
}

.pricing-card h2 {
    margin: .4rem 0;
    color: #0D1933;
}

.pricing-card p {
    margin-bottom: 0;
    color: #667085;
}

.pricing-price {
    color: #D97706;
    font-size: 1.4rem;
}

.about-note {
    max-width: 620px;
    margin-top: 3rem;
    border-left: 4px solid #D97706;
}

.login-page {
    max-width: 560px;
}

.login-form {
    display: grid;
    gap: .55rem;
    margin-top: 2rem;
}

.login-form label {
    margin-top: .75rem;
    color: #0D1933;
    font-size: .9rem;
    font-weight: 700;
}

.login-form input {
    padding: .8rem 1rem;
    border: 1px solid #E0E0E0;
    border-radius: .4rem;
    color: #0D1933;
    font: inherit;
}

.login-form button {
    width: fit-content;
    margin-top: 1rem;
    border: 0;
    cursor: pointer;
    font: inherit;
}

.terms-content {
    max-width: 700px;
    margin-top: 3rem;
}

@media (max-width: 700px) {
    .public-info-page {
        width: min(100% - 2rem, 900px);
        padding-top: 4rem;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }
}
