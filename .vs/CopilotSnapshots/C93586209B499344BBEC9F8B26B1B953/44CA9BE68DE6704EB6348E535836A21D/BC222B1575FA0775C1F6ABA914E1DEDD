    public async Task SetUserRoleAsync(string actorRole, int userId, string role)
    {
        EnsureAdmin(actorRole);
        if (!new[] { "Cliente", "Recepcionista", "Veterinario", "Administrador" }.Contains(role)) throw new DomainOperationException("El rol seleccionado no es válido.");
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("UPDATE dbo.Usuarios SET Rol = @role WHERE Id = @id", connection);
        command.Parameters.Add("@role", SqlDbType.NVarChar, 20).Value = role;
        command.Parameters.Add("@id", SqlDbType.Int).Value = userId;
        if (await command.ExecuteNonQueryAsync() == 0) throw new DomainOperationException("El usuario no existe.");
    }

