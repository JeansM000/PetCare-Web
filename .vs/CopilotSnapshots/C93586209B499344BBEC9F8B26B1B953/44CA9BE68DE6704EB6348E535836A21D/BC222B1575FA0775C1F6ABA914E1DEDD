    private async Task EnsureVeterinarianAsync(int id)
    {
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("SELECT COUNT(*) FROM dbo.Usuarios WHERE Id = @id AND Rol = 'Veterinario'", connection); command.Parameters.Add("@id", SqlDbType.Int).Value = id;
