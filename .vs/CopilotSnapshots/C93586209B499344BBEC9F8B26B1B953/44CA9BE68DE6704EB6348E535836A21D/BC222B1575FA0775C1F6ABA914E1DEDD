    public async Task CreateAppointmentAsync(string actorRole, AppointmentInput input)
    {
        EnsureCanOperate(actorRole);
        if (input.DurationMinutes < 45 || input.DurationMinutes > 180) throw new DomainOperationException("La duración de una cita debe estar entre 45 y 180 minutos.");
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("INSERT INTO dbo.Servicios (Codigo, Tipo, NombreMascota, Fecha, DuracionMinutos, VeterinarioAsignado, VeterinarioId) VALUES (@code, 'Cita', @pet, @date, @duration, (SELECT NombreCompleto FROM dbo.Usuarios WHERE Id = NULLIF(@vet, 0)), NULLIF(@vet, 0))", connection);
        AddAppointmentParameters(command, input);
        await ExecuteWithDomainErrorAsync(command, "No se pudo registrar la cita. Verifica que el código no esté repetido.");
    }

    public async Task CreateHospitalizationAsync(string actorRole, HospitalizationInput input)
    {
        EnsureCanOperate(actorRole);
        if (input.AdmissionDate == default) throw new DomainOperationException("La fecha de ingreso es obligatoria.");
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("INSERT INTO dbo.Servicios (Codigo, Tipo, NombreMascota, Fecha, VeterinarioAsignado, VeterinarioId, TarifaDiaria, JaulaId, TamanoJaula) SELECT @code, 'Hospitalizacion', @pet, @date, u.NombreCompleto, NULLIF(@vet, 0), j.TarifaDiaria, j.Id, j.Tamano FROM dbo.Jaulas j LEFT JOIN dbo.Usuarios u ON u.Id = NULLIF(@vet, 0) WHERE j.Id = @cage AND j.Activa = 1", connection);
        command.Parameters.Add("@code", SqlDbType.NVarChar, 20).Value = input.Code.Trim();
        command.Parameters.Add("@pet", SqlDbType.NVarChar, 80).Value = input.PetName.Trim();
        command.Parameters.Add("@date", SqlDbType.DateTime2).Value = input.AdmissionDate;
        command.Parameters.Add("@vet", SqlDbType.Int).Value = input.VeterinarianId;
        command.Parameters.Add("@cage", SqlDbType.Int).Value = input.CageId;
        if (await command.ExecuteNonQueryAsync() == 0) throw new DomainOperationException("La jaula no está disponible o el veterinario no existe.");
    }

