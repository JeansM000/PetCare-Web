    }

    private static void EnsureAdmin(string role) { if (role != "Administrador") throw new DomainOperationException("Solo un Administrador puede realizar esta operación."); }
    private static void EnsureCanOperate(string role) { if (role is not ("Administrador" or "Recepcionista" or "Veterinario")) throw new DomainOperationException("Tu rol no permite registrar esta operación."); }
    private static void AddAppointmentParameters(SqlCommand command, AppointmentInput input) { command.Parameters.Add("@code", SqlDbType.NVarChar, 20).Value = input.Code.Trim(); command.Parameters.Add("@pet", SqlDbType.NVarChar, 80).Value = input.PetName.Trim(); command.Parameters.Add("@date", SqlDbType.DateTime2).Value = input.Date; command.Parameters.Add("@duration", SqlDbType.Int).Value = input.DurationMinutes; command.Parameters.Add("@vet", SqlDbType.Int).Value = input.VeterinarianId; }
    private static async Task ExecuteWithDomainErrorAsync(SqlCommand command, string message) { try { if (await command.ExecuteNonQueryAsync() == 0) throw new DomainOperationException(message); } catch (SqlException) { throw new DomainOperationException(message); } }
    private async Task<SqlConnection> OpenConnectionAsync() { var connection = new SqlConnection(_connectionString); await connection.OpenAsync(); return connection; }

    private static bool VerifyPassword(string password, string storedValue)
    {
        var parts = storedValue.Split('$'); if (parts.Length != 4 || parts[0] != "PBKDF2-SHA256" || !int.TryParse(parts[1], out var iterations) || iterations < 1000 || iterations > 1_000_000) return false;
        try { var salt = Convert.FromBase64String(parts[2]); var expected = Convert.FromBase64String(parts[3]); var actual = Rfc2898DeriveBytes.Pbkdf2(password, salt, iterations, HashAlgorithmName.SHA256, expected.Length); return CryptographicOperations.FixedTimeEquals(actual, expected); } catch (FormatException) { return false; }
    }

