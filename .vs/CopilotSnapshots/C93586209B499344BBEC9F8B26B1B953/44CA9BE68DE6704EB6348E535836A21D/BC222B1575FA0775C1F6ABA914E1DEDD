    public sealed record ServiceRow(int Id, string Code, string Type, string PetName, DateTime Date, string? Veterinarian, int? DurationMinutes, decimal? DailyRate, DateTime? DischargeDate, string? CageSize, int? CageId);
    public sealed record ProductRow(int Id, string Code, string Name, decimal UnitPrice, DateTime? ExpirationDate, string? BatchNumber, int Quantity, bool IsExpired);
    public sealed record InvoiceRow(int Id, string Number, DateTime IssuedAt, string Customer, bool IsCancelled, string IssuedBy, decimal Total);
    public sealed record InvoiceLineInput(int? ServiceId, int? ProductId, int Quantity, decimal UnitPrice);
    public sealed record InvoiceLineRow(string Code, string Description, int Quantity, decimal UnitPrice);
    public sealed record InvoiceDetail(string Number, DateTime IssuedAt, string Customer, bool IsCancelled, List<InvoiceLineRow> Lines);
    public sealed record UnifiedItem(string Origin, string Code, string Description, DateTime Date, decimal Amount);
    public sealed record AppointmentInput(string Code, string PetName, DateTime Date, int DurationMinutes, int VeterinarianId);
    public sealed record HospitalizationInput(string Code, string PetName, DateTime AdmissionDate, int VeterinarianId, int CageId);
    public sealed record ProductInput(string Code, string Name, decimal UnitPrice, DateTime ExpirationDate, string BatchNumber, int Quantity);
}

public sealed class DomainOperationException(string message) : Exception(message);
