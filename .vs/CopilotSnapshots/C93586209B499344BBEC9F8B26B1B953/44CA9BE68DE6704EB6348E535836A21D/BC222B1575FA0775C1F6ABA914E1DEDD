    public async Task CreateProductAsync(string actorRole, ProductInput input)
    {
        EnsureCanOperate(actorRole);
        if (input.ExpirationDate <= DateTime.Today || input.Quantity <= 0 || input.UnitPrice <= 0) throw new DomainOperationException("El lote debe tener vencimiento futuro, cantidad y precio mayor que cero.");
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("INSERT INTO dbo.Productos (Codigo, Tipo, Nombre, PrecioUnidad, FechaVencimiento, NumeroLote, CantidadDisponible) VALUES (@code, 'LoteMedicamento', @name, @price, @expiry, @batch, @quantity)", connection);
        command.Parameters.Add("@code", SqlDbType.NVarChar, 20).Value = input.Code.Trim(); command.Parameters.Add("@name", SqlDbType.NVarChar, 100).Value = input.Name.Trim(); command.Parameters.Add("@price", SqlDbType.Decimal).Value = input.UnitPrice; command.Parameters.Add("@expiry", SqlDbType.Date).Value = input.ExpirationDate.Date; command.Parameters.Add("@batch", SqlDbType.NVarChar, 40).Value = input.BatchNumber.Trim(); command.Parameters.Add("@quantity", SqlDbType.Int).Value = input.Quantity;
        await ExecuteWithDomainErrorAsync(command, "No se pudo registrar el lote. El código puede estar repetido.");
    }

    public async Task CreateUserAsync(string actorRole, string username, string fullName, string password)
    {
        EnsureAdmin(actorRole);
        if (string.IsNullOrWhiteSpace(username) || username.Length > 50 || string.IsNullOrWhiteSpace(fullName) || fullName.Length > 100 || password.Length < 8)
            throw new DomainOperationException("El usuario, nombre completo y una contraseña de al menos 8 caracteres son obligatorios.");

        var salt = RandomNumberGenerator.GetBytes(16);
        var hash = Rfc2898DeriveBytes.Pbkdf2(password, salt, 100000, HashAlgorithmName.SHA256, 32);
        var stored = $"PBKDF2-SHA256$100000${Convert.ToBase64String(salt)}${Convert.ToBase64String(hash)}";
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("INSERT INTO dbo.Usuarios (Nombreusuario, NombreCompleto, ContrasenaHash, Rol) VALUES (@username, @fullName, @hash, 'Cliente')", connection);
        command.Parameters.Add("@username", SqlDbType.NVarChar, 50).Value = username.Trim();
        command.Parameters.Add("@fullName", SqlDbType.NVarChar, 100).Value = fullName.Trim();
        command.Parameters.Add("@hash", SqlDbType.NVarChar, 200).Value = stored;
        await ExecuteWithDomainErrorAsync(command, "No se pudo crear el usuario. El nombre de usuario puede estar repetido.");
    }

