    public async Task CreateInvoiceAsync(string actorRole, string number, string customer, int issuerId, IReadOnlyList<InvoiceLineInput> lines)
    {
        EnsureCanOperate(actorRole);
        if (string.IsNullOrWhiteSpace(number) || string.IsNullOrWhiteSpace(customer) || lines.Count == 0) throw new DomainOperationException("La factura necesita número, cliente y al menos un renglón.");
        await using var connection = await OpenConnectionAsync();
        await using var transaction = (SqlTransaction)await connection.BeginTransactionAsync();
        try
        {
            await using var invoice = new SqlCommand("INSERT INTO dbo.Facturas (Numero, FechaEmision, NombreCliente, UsuarioEmisorId) OUTPUT INSERTED.Id VALUES (@number, SYSDATETIME(), @customer, @issuer)", connection, transaction);
            invoice.Parameters.Add("@number", SqlDbType.NVarChar, 20).Value = number.Trim(); invoice.Parameters.Add("@customer", SqlDbType.NVarChar, 100).Value = customer.Trim(); invoice.Parameters.Add("@issuer", SqlDbType.Int).Value = issuerId;
            var invoiceId = (int)(await invoice.ExecuteScalarAsync() ?? throw new DomainOperationException("No se pudo crear la factura."));
            foreach (var line in lines)
            {
                if ((line.ServiceId is null) == (line.ProductId is null) || line.Quantity <= 0 || line.UnitPrice < 0) throw new DomainOperationException("Cada renglón debe referenciar un único servicio o producto y tener valores válidos.");
                await using var lineCommand = new SqlCommand("INSERT INTO dbo.LineasFactura (FacturaId, ServicioId, ProductoId, Cantidad, PrecioUnitario) VALUES (@invoice, @service, @product, @quantity, @price)", connection, transaction);
                lineCommand.Parameters.Add("@invoice", SqlDbType.Int).Value = invoiceId; lineCommand.Parameters.Add("@service", SqlDbType.Int).Value = (object?)line.ServiceId ?? DBNull.Value; lineCommand.Parameters.Add("@product", SqlDbType.Int).Value = (object?)line.ProductId ?? DBNull.Value; lineCommand.Parameters.Add("@quantity", SqlDbType.Int).Value = line.Quantity; lineCommand.Parameters.Add("@price", SqlDbType.Decimal).Value = line.UnitPrice;
                await lineCommand.ExecuteNonQueryAsync();
            }
            await transaction.CommitAsync();
        }
        catch (DomainOperationException) { await transaction.RollbackAsync(); throw; }
        catch (SqlException) { await transaction.RollbackAsync(); throw new DomainOperationException("No se pudo crear la factura. Comprueba el número y los renglones."); }
    }

    public async Task<InvoiceDetail?> GetInvoiceDetailAsync(int invoiceId)
    {
        await using var connection = await OpenConnectionAsync();
        await using var command = new SqlCommand("SELECT f.Numero, f.FechaEmision, f.NombreCliente, f.EstaAnulada, l.Id, COALESCE(s.Codigo, p.Codigo), CASE WHEN l.ServicioId IS NULL THEN p.Nombre ELSE CONCAT(s.Tipo, ' - ', s.NombreMascota) END, l.Cantidad, l.PrecioUnitario FROM dbo.Facturas f LEFT JOIN dbo.LineasFactura l ON l.FacturaId = f.Id LEFT JOIN dbo.Servicios s ON s.Id = l.ServicioId LEFT JOIN dbo.Productos p ON p.Id = l.ProductoId WHERE f.Id = @id ORDER BY l.Id", connection); command.Parameters.Add("@id", SqlDbType.Int).Value = invoiceId;
        await using var reader = await command.ExecuteReaderAsync();
        InvoiceDetail? detail = null;
        while (await reader.ReadAsync())
        {
            detail ??= new InvoiceDetail(reader.GetString(0), reader.GetDateTime(1), reader.GetString(2), reader.GetBoolean(3), []);
            if (!reader.IsDBNull(4)) detail.Lines.Add(new InvoiceLineRow(reader.GetString(5), reader.GetString(6), reader.GetInt32(7), reader.GetDecimal(8)));
        }
        return detail;
    }

