@page "/unificado"
@attribute [Authorize]
@attribute [Authorize(Roles = "Administrador,Recepcionista,Veterinario")]
@rendermode InteractiveServer
@inject PetCare_Proyecto_final.Data.PetCareDataService Data

<PageTitle>Servicios y productos | PetCare</PageTitle>

<div class="saas-page-heading"><div><span class="page-eyebrow">Consulta general</span><h1>Servicios y productos</h1><p>Una vista unificada de la actividad y el inventario.</p></div></div>
@if (Rows is null){<div class="loading-state">Cargando registros...</div>}else{<div class="data-card"><div class="data-card-header"><strong>Lista unificada</strong><span>@Rows.Count registros</span></div><div class="table-scroll"><table class="saas-table"><thead><tr><th>Origen</th><th>Código</th><th>Descripción</th><th>Fecha</th><th>Valor</th></tr></thead><tbody>@foreach(var row in Rows){<tr><td><span class="type-badge">@row.Origin</span></td><td class="table-primary">@row.Code</td><td>@row.Description</td><td>@row.Date.ToString("dd/MM/yyyy")</td><td>@row.Amount.ToString("N0")</td></tr>}</tbody></table></div></div>}

@code { private IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.UnifiedItem>? Rows; protected override async Task OnInitializedAsync()=>Rows=await Data.GetUnifiedItemsAsync(); }
