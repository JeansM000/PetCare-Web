@using System.ComponentModel.DataAnnotations

<div class="form-card">
    <div class="form-card-header"><div><span class="page-eyebrow">Nueva cita</span><h2>Registrar cita médica</h2></div></div>
    @if (!string.IsNullOrEmpty(ValidationMessage))
    {
        <div class="operation-error toast-message" role="alert">@ValidationMessage</div>
    }
    <EditForm Model="Model" OnValidSubmit="SubmitAsync" OnInvalidSubmit="ShowValidationError">
        <DataAnnotationsValidator />
        <div class="form-grid">
            <div class="field"><label for="service-code">Código automático</label><input id="service-code" class="readonly-field" value="SER-######" readonly /></div>
            <div class="field"><label for="service-type">Tipo</label><input id="service-type" class="readonly-field" value="Cita médica" readonly /></div>
            <div class="field"><label for="pet-name">Nombre de mascota</label><InputText id="pet-name" @bind-Value="Model.PetName" maxlength="80" /></div>
            <div class="field"><label for="client">Cliente <span class="optional-field">(opcional)</span></label><InputSelect id="client" @bind-Value="Model.ClientId"><option value="0">Sin asignar</option>@foreach (var client in Clients){<option value="@client.Id">@client.Name</option>}</InputSelect></div>
            <div class="field"><label for="service-date">Fecha y hora de la cita</label><InputDate id="service-date" @bind-Value="Model.Date" Type="InputDateType.DateTimeLocal" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" /><small class="field-help">Solo se permiten citas desde el momento actual.</small></div>
            <div class="field"><label for="veterinarian">Veterinario <span class="optional-field">(opcional)</span></label><InputSelect id="veterinarian" @bind-Value="Model.VeterinarianId"><option value="0">Asignar después</option>@foreach (var vet in Veterinarians){<option value="@vet.Id">@vet.Name</option>}</InputSelect></div>
            <div class="field"><label for="duration">Duración (minutos)</label><InputNumber id="duration" @bind-Value="Model.DurationMinutes" min="15" max="180" /></div>
        </div>
        <button class="saas-primary-button" type="submit"><i data-lucide="save" aria-hidden="true"></i> Registrar</button>
    </EditForm>
</div>

@code {
    [Parameter] public IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.VetOption> Veterinarians { get; set; } = [];
    [Parameter] public IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.ClientOption> Clients { get; set; } = [];
    [Parameter] public IReadOnlyList<PetCare_Proyecto_final.Data.PetCareDataService.CageRow> Cages { get; set; } = [];
    [Parameter] public EventCallback<ServiceFormModel> OnSubmit { get; set; }
    private ServiceFormModel Model { get; set; } = NewModel();
    private string? ValidationMessage;
    // No se reinicia el modelo: si el servicio rechaza la cita, los datos quedan como estaban (HU-17 CA4).
    // Cuando el registro tiene éxito, la página cierra el modal y el formulario se crea de nuevo.
    private async Task SubmitAsync(){ValidationMessage=null;await OnSubmit.InvokeAsync(Model);}
    private void ShowValidationError(){ValidationMessage="La mascota y la fecha son obligatorias. La cita no puede quedar en el pasado y debe durar entre 15 y 180 minutos.";}
    private static ServiceFormModel NewModel()=>new(){Date=DateTime.Now.AddHours(1),DurationMinutes=30};
    public sealed class ServiceFormModel{public string Code{get;set;}="";[Required(ErrorMessage="La mascota es obligatoria.")]public string PetName{get;set;}=string.Empty;public string Type{get;set;}="Cita";[Required]public DateTime Date{get;set;}[Range(15,180,ErrorMessage="La cita debe durar entre 15 y 180 minutos.")]public int DurationMinutes{get;set;}=30;public int VeterinarianId{get;set;}public int CageId{get;set;}public int ClientId{get;set;}}
}
